{
  "name": "Pay & Route",
  "short_name": "Pay & Route",
  "start_url": "./index.html#today",
  "scope": "./",
  "display": "standalone",
  "background_color": "#111111",
  "theme_color": "#111111",
  "icons": [
    {
      "src": "icon-192.png",
      "sizes": "192x192",
      "type": "image/png"
    },
    {
      "src": "icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any maskable"
    }
  ],
  "share_target": {
    "action": "./share-target",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "title": "title",
      "text": "text",
      "files": [
        {
          "name": "file",
          "accept": [
            "text/plain",
            ".txt",
            ".csv",
            ".eml",
            "message/rfc822",
            "application/pdf",
            ".pdf",
            "image/*",
            "image/png",
            "image/jpeg",
            "image/webp",
            ".png",
            ".jpg",
            ".jpeg"
          ]
        }
      ]
    }
  }
}